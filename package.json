{
  "name": "jev-xray",
  "version": "0.1.0",
  "description": "X-ray any codebase with Jev: ask every file a typed question at once and watch the answer light up the repo.",
  "type": "module",
  "bin": {
    "jev-xray": "bin/jev-xray.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "lenses"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/jev-xray.js .",
    "simulate": "node bin/jev-xray.js . --simulate",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "codebase",
    "code-review",
    "visualization",
    "treemap",
    "coding-agents"
  ],
  "license": "MIT"
}
